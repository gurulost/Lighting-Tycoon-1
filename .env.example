# Template for required environment variables.
# Note: this repo does not auto-load .env files. Export these in your shell.

DATABASE_URL=postgres://user:pass@localhost:5432/lighting_tycoon
EXPO_PUBLIC_DOMAIN=localhost:5000
EXPO_PUBLIC_RELEASE_CHANNEL=production
# PostHog client ingestion (safe to ship in client)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# PostHog querying/analysis (server-side only, keep secret)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Optional
PORT=5000
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
