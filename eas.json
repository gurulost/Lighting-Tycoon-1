{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "node": "22.23.3",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "production"
      }
    },
    "testflight": {
      "extends": "production"
    },
    "playtest": {
      "node": "22.23.3",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "playtest"
      }
    },
    "e2e": {
      "node": "22.23.3",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "e2e"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
